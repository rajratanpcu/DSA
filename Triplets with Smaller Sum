import java.util.Arrays;

public class Solution {
    public int countTriplets(int[] arr, int target) {
        Arrays.sort(arr);
        int n = arr.length;
        int count = 0;

        for (int i = 0; i < n - 2; i++) {
            int left = i + 1, right = n - 1;
            while (left < right) {
                int sum = arr[i] + arr[left] + arr[right];
                if (sum < target) {
                    count += (right - left);
                    left++;
                } else {
                    right--;
                }
            }
        }
        return count;
    }

    public static void main(String[] args) {
        int[] a = {-2, 0, 1, 3};
        int k = 2;

        Solution ob = new Solution();   // ✅ matches class name
        int ans = ob.countTriplets(a, k);
        System.out.println("Count of triplets: " + ans);
    }
}
